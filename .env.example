# Copy this file to .env and fill in the values you need.
# Every section below degrades gracefully when unset: the app runs in a
# single-instance, local-storage, console-logging dev mode by default, and
# picks up the real cloud-backed adapter the moment the matching vars are set.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://kintsu:kintsu_dev_password@localhost:5432/kintsu_os

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cache / rate limiting (optional — falls back to an in-process store)
# ---------------------------------------------------------------------------
# Any Redis-protocol URL works: self-hosted Redis, Valkey, or Upstash
# (rediss://...upstash.io). Required for rate limiting and sessions to be
# consistent across more than one app instance.
REDIS_URL=

# ---------------------------------------------------------------------------
# File storage (optional — falls back to local disk under public/uploads)
# ---------------------------------------------------------------------------
# S3-compatible: works with AWS S3 or Cloudflare R2 (set S3_ENDPOINT for R2).
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Public base URL to read objects back through (CDN / R2 public bucket /
# CloudFront domain). Falls back to S3_ENDPOINT/S3_BUCKET when unset.
S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Notifications (optional — falls back to a console/dev adapter that still
# writes a notificationLog row)
# ---------------------------------------------------------------------------
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Website / integrations
# ---------------------------------------------------------------------------
WEBSITE_SYNC_API_KEY=

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Backups (optional — used by scripts/backup.sh)
# ---------------------------------------------------------------------------
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
# When set, scripts/backup.sh uploads each dump via the S3 storage adapter
# (S3_* vars above) under this prefix in addition to keeping it locally.
BACKUP_S3_PREFIX=
